{
  "manifest_version": 3,
  "name": "PlanB Orthanc Wizzard",
  "version": "1.0.0",
  "description": "Автоматическое заполнение данных пациентов в PlanB из КТ-исследований Orthanc",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "css": ["modal.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "PlanB Wizzard Settings"
  }
}
